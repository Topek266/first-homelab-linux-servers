[DEFAULT]
# Czas bana w sekundach
bantime = 3600
# Czas w sekundach w którym fail2ban zlicza nieudane próby
findtime = 600
# Maksymalna liczba nieudanych prób w czasie findtime
maxretry = 3
# Te IP nigdy nie zostaną zbanowane
ignoreip = 127.0.0.1/8 192.168.66.0/24

[sshd]
# Włącza ten jail
enabled = true
# Port na którym nasłuchuje
port = 2223
# Filtr który określa co szukać w logach
filter = sshd
# Ścieżka do logów który fail2ban monitoruje
logpath = /var/log/auth.log
# Maksymalna liczba nieudanych prób -- nadpisuje wartość z DEFAULT
maxretry = 3

[vsftpd]
# Włącza ten jail
enabled = true
# Port na którym nasłuchuje
Port = 20, 21
# Filtr który określa co szukać w logach
filter vsftpd
# Ścieżka do logów który fail2ban monitoruje
logpath = /var/log/vsftpd.log

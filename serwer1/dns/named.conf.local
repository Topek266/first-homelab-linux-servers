//===================================//
// Strefa lab.local mojego homelab   //
//===================================//

// Definiuje nazwę strefy DNS
zone "lab.local" {
    // Ten serwer jest głównym serwerem tej strefy
    type master;
    // Plik z rekordami DNS
    file "/etc/bind/db.lab.local";

    // Zabezpiecza przed kopiowaniem strefy
    allow-transfer { none; };
};
